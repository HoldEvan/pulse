    <string name="cd_script_docs">檢視腳本文件</string>
    <string name="script_docs_title">腳本 API 文件</string>
    <string name="script_docs_intro">以下 API 與 Postman Runtime 的 pm 物件一致，腳本在 Rhino JavaScript 引擎中執行。</string>
    <string name="script_docs_props_note">pm.variables、pm.environment 與 pm.globals 指向同一個物件，用 .get(name) 讀取，用 .set(name, value) 寫入。</string>
    <string name="script_docs_group_request">請求</string>
    <string name="script_docs_group_response">回應</string>
    <string name="script_docs_group_variables">變數</string>
    <string name="script_docs_group_log">日誌與斷言</string>
    <string name="script_docs_examples_title">範例</string>
    <string name="script_docs_example_pre">// 寫入追蹤 ID，設定請求標頭，並組裝 JSON 請求體\npm.variables.set(\"traceId\", Date.now());\npm.request.setHeader(\"X-Request-Id\", pm.variables.get(\"traceId\"));\npm.request.body.mode = \"raw\";\npm.request.body.json = { token: pm.variables.get(\"token\") };</string>
    <string name="script_docs_example_post">// 校驗狀態碼與耗時，並把 id 寫入環境\nif (pm.response.statusCode !== 200) {\n    throw new Error(\"expected 200, got \" + pm.response.statusCode);\n}\nif (pm.response.time &gt; 2000) {\n    throw new Error(\"too slow: \" + pm.response.time + \"ms\");\n}\nconst body = pm.response.json();\nif (body.id) pm.environment.set(\"userId\", body.id);\npm.log(\"done in \" + pm.response.time + \"ms\");</string>
