<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pulse 是接口调试工具，开发/测试中的内网与本地服务普遍使用明文 HTTP，
         若沿用系统默认策略（Android 9+ 禁止明文），http:// 与 192.168.x.x 这类
         地址会在建连前被系统拦截并报 "not permitted by network security policy"。
         因此此处显式放开明文流量。 -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
