    <string name="cd_script_docs">查看脚本文档</string>
    <string name="script_docs_title">脚本 API 文档</string>
    <string name="script_docs_intro">以下 API 与 Postman Runtime 的 pm 对象一致，脚本在 Rhino JavaScript 引擎中运行。</string>
    <string name="script_docs_props_note">pm.variables、pm.environment 与 pm.globals 指向同一个对象，用 .get(name) 读取，用 .set(name, value) 写入。</string>
    <string name="script_docs_group_request">请求</string>
    <string name="script_docs_group_response">响应</string>
    <string name="script_docs_group_variables">变量</string>
    <string name="script_docs_group_log">日志与断言</string>
    <string name="script_docs_examples_title">示例</string>
    <string name="script_docs_example_pre">// 写入追踪 ID，设置请求头，并组装 JSON 请求体\npm.variables.set(\"traceId\", Date.now());\npm.request.setHeader(\"X-Request-Id\", pm.variables.get(\"traceId\"));\npm.request.body.mode = \"raw\";\npm.request.body.json = { token: pm.variables.get(\"token\") };</string>
    <string name="script_docs_example_post">// 校验状态码与耗时，并把 id 写入环境\nif (pm.response.statusCode !== 200) {\n    throw new Error(\"expected 200, got \" + pm.response.statusCode);\n}\nif (pm.response.time &gt; 2000) {\n    throw new Error(\"too slow: \" + pm.response.time + \"ms\");\n}\nconst body = pm.response.json();\nif (body.id) pm.environment.set(\"userId\", body.id);\npm.log(\"done in \" + pm.response.time + \"ms\");</string>
